[Unit]
Description=NeoSys Pharma FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neosys
Group=neosys
WorkingDirectory=/opt/neosys-pharma/NeoSys_Pharma
EnvironmentFile=/etc/neosys-pharma.env
ExecStart=/opt/neosys-pharma/venv/bin/uvicorn neosys_pharma.presentation.api.app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neosys-pharma

[Install]
WantedBy=multi-user.target
